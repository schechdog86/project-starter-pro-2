# === AI API KEYS ===
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_claude_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here
HUGGINGFACE_API_KEY=your_hf_key_here

# === MODEL CONFIGURATION ===
MODEL_PROVIDER=openai
MODEL_PATH=/models
EMBEDDING_BACKEND=sentence-transformers
VECTOR_DB=chromadb

# === MULTI-AGENT FRAMEWORKS ===
AUTOGEN_API_KEY=${OPENAI_API_KEY}
CREWAI_LOG_LEVEL=info
LANGGRAPH_STATE_PATH=/data/langgraph_state
SWARM_API_KEY=${OPENAI_API_KEY}
SUPERAGI_CONFIG_PATH=/app/superagi/config
TASKWEAVER_DATA_PATH=/app/taskweaver/data

# === DATABASES / STORAGE ===
POSTGRES_URL=postgresql+asyncpg://psp_user:psp_pass@db:5432/psp
REDIS_URL=redis://redis:6379/0

# === JWT / SECURITY ===
SECRET_KEY=supersecret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

