{
  "name": "web_search",
  "version": "1.0.0",
  "description": "Search the web for information using DuckDuckGo",
  "category": "research",
  "enabled": true,
  "parameters": {
    "query": {
      "type": "string",
      "required": true,
      "description": "Search query"
    },
    "num_results": {
      "type": "integer",
      "default": 5,
      "description": "Number of results to return"
    }
  },
  "dependencies": ["requests", "beautifulsoup4"],
  "frameworks": ["crewai", "autogen", "langchain"],
  "permissions": ["network"],
  "timeout": 30
}

