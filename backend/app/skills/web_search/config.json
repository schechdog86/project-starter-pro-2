{
  "name": "web_search",
  "version": "1.0.0",
  "description": "Search the web and return titles (demo).",
  "category": "research",
  "enabled": false,
  "parameters": {
    "query": {
      "type": "string",
      "required": true,
      "description": "Search query"
    },
    "num_results": {
      "type": "integer",
      "required": false,
      "description": "How many",
      "default": 5
    }
  },
  "permissions": ["network"],
  "timeout": 30
}

