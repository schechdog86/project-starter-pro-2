# Test Environment Variables
# For testing orchestrator without real API keys

# LLM API Keys (use dummy values for testing)
OPENAI_API_KEY=sk-test-dummy-key-for-testing
ANTHROPIC_API_KEY=sk-ant-test-dummy-key
DEEPSEEK_API_KEY=sk-test-dummy-key

# Database
DATABASE_URL=postgresql+asyncpg://psp_user:psp_pass@localhost/psp

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=test-secret-key-for-development-only
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Settings
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# Memory Settings
MEMORY_EMBEDDING_MODEL=all-MiniLM-L6-v2
MEMORY_BASE_PATH=data/memory

# Firecrawl (optional)
FIRECRAWL_API_KEY=fc-test-dummy-key

